## Placeholder arvot. Kopioi tiedosto nimelle .env ja vaihda salaisuudet. Älä lisää .env:iä Gitiin.

# PostgreSQL
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=appdb

# Paikallinen ajo ilman Dockeria. Docker Compose ylikirjoittaa tämän (host = db).
DATABASE_URL=postgresql+psycopg://username:password@localhost/appdb

API_HOST=0.0.0.0
API_PORT=8000

# CORS: sallitut frontend-originit pilkulla eroteltuna (Vite dev server)
CORS_ORIGINS=http://localhost:5173

# SQLAdmin (/admin): oma erillinen kirjautuminen, EI sovelluksen JWT. Vaihda jaetussa käytössä!
SQLADMIN_USERNAME=admin
SQLADMIN_PASSWORD=admin
SQLADMIN_SECRET_KEY=vaihdaminut

# JWT: tokenien allekirjoitusavain (pakollinen) ja tokenin voimassaoloaika minuutteina
SECRET_KEY=salainenavain-vaihda-minut
ACCESS_TOKEN_EXPIRE_MINUTES=30
